# Local development only. Copy this file to backend/.env and fill in your own values.
DEBUG=true
SECRET_KEY=replace-with-a-long-random-local-secret

# Protrack365 API account used to fetch GPS data by IMEI.
PROTRACK_ACCOUNT=
PROTRACK_PASSWORD=

# Use these only when you need to override the defaults.
# DATABASE_URL=postgresql://user:password@host:5432/database
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
